# Copy to .env.local for local development (gitignored):
#   npm run setup:env

NEXT_PUBLIC_SUPABASE_URL=https://vdrnkhtltpwrkfjnlasf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only — never expose as NEXT_PUBLIC_
# Maps business ID to Supabase Auth email until resolve_brand_auth_email RPC exists.
# BRAND_AUTH_EMAIL_MAP={"BR-1":"your-auth-user@example.com"}

# ---------------------------------------------------------------------------
# OrderBook AI (optional) — SERVER ONLY.
# None of these may be NEXT_PUBLIC_*: a model key inlined into the browser
# bundle is a public key. With no key the assistant still works and answers
# from the local insight engine, and says so on screen.
# ---------------------------------------------------------------------------
# ORDERBOOK_AI_API_KEY=your_model_api_key
# ORDERBOOK_AI_BASE_URL=https://your-provider.example/v1
# ORDERBOOK_AI_MODEL=your-model-id

# ---------------------------------------------------------------------------
# External integrations (optional) — SERVER ONLY.
# OAuth, the code exchange and token refresh all happen on the server; the
# tokens are encrypted with INTEGRATION_ENCRYPTION_KEY before they are stored.
# Generate a key with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without the key, connecting an account is refused rather than stored in clear.
#
# Google Cloud Console → OAuth client (web application), redirect URI:
#   https://your-app.example/api/integrations/google/callback
# Scopes requested are read/draft only: calendar.readonly, calendar.events,
# gmail.readonly, gmail.compose. There is no gmail.send anywhere.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# INTEGRATION_ENCRYPTION_KEY=64_hex_characters
#
# WhatsApp Business Cloud API (Meta) — send-only, and every send needs a
# confirmation click in the app first.
# WHATSAPP_ACCESS_TOKEN=your_permanent_cloud_api_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ---------------------------------------------------------------------------
# Deployment data switch.
# The app currently runs CSV-ONLY: every read/write goes through data/*.csv
# and all Supabase paths are dormant (code kept, switched off centrally via
# supabaseEnabled() in src/lib/env.ts). To re-enable live mode, set:
#   OB_USE_SUPABASE=true
# AND provide the NEXT_PUBLIC_SUPABASE_* keys above.
# ---------------------------------------------------------------------------
# OB_USE_SUPABASE=true

# ---------------------------------------------------------------------------
# Server Actions behind a reverse proxy (optional) — SERVER ONLY.
# Next checks that a Server Action's `Origin` matches the host the app serves.
# That is the CSRF defence and normally needs no configuration. A proxy,
# tunnel or preview gateway that forwards its own internal `x-forwarded-host`
# makes the two differ, and every action (demo entry, billing, settings,
# CRM) then aborts with "Invalid Server Actions request" while plain page
# loads still work. List the public origin the browser actually uses —
# comma-separated, `*.` wildcards allowed — and the check keeps working for
# every other origin:
#   OB_ACTION_ALLOWED_ORIGINS=*.preview.example.com
# ---------------------------------------------------------------------------
# OB_ACTION_ALLOWED_ORIGINS=your-app.example.com
